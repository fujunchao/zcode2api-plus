# ── 服务 ──────────────────────────────────────────
ZCODE_PORT=3000
ZCODE_HOST=0.0.0.0

# ── 鉴权 ──────────────────────────────────────────
# 后台密码初始值（仅在数据库缺失或仍为历史默认值时生效，之后以数据库为准）；
# 不设置时首次启动随机生成并打印于启动日志。请勿沿用旧默认值 zcode。
#ZCODE_ADMIN_KEY=改成你的后台密码
# 网关 API Key 初始值（一律必填，未设置时随机生成，打印于启动日志）
#ZCODE_GATEWAY_KEY=改成你的网关金钥

# ── 数据目录（账号保存在本目录下的 SQLite）────────
ZCODE_DATA_DIR=./data

# ── 用量监控 ──────────────────────────────────────
# 后台自动刷新各账号额度的间隔（秒），0 关闭
ZCODE_QUOTA_REFRESH_INTERVAL=60
# 限流冷却时长（秒）
ZCODE_COOLING_SECONDS=300

# ── 套餐领取 ──────────────────────────────────────
# 以下三项只是默认值：后台「系统设置」页可在线修改并即时生效，无需重启。
# 领取冷却只作用于「入池自动领取」；手动点按钮始终可强制触发。
# 优先用上游返回的 ends_at 作为下次可领时间，没有时按失败成因取以下两档（秒）：
# 验证码不可用 / 已领过但上游未给时间
ZCODE_CLAIM_CAPTCHA_COOLDOWN=3600
# 其他失败（网络、参数等）
ZCODE_CLAIM_RETRY_COOLDOWN=600
# 「刷新资格」只读探测的节流（秒），0 关闭
ZCODE_CLAIM_PREVIEW_COOLDOWN=60

# ── 代理线路自动巡检 ──────────────────────────────
# 周期对全部启用线路做 z.ai 可达性检测；不通过的线路自动移除，其绑定账号按
# 「空閒优先、其次绑定账号数最少」改派，没有可用线路时退回直连。
# 全部线路不可用且直连也不可达时视为本机网络故障，跳过该轮移除（防止一次
# 网络抖动清空整个线路池）。
ZCODE_PROXY_HEALTH_ENABLED=true
# 巡检间隔（分钟）
# 注意：这两个变量只是**默认值**——后台「系统设置」页可在线修改开关与间隔，
# 落库后以设置页为准（即改即生效，无需重启）。
ZCODE_PROXY_HEALTH_INTERVAL=30

# ── 上行带宽与首字节预算 ──────────────────────────
# 模型请求体中位数约 324KB，必须经代理**上行**写入上游；首字节延迟几乎完全由
# 「请求体 ÷ 线路上行速率」决定（实测相关系数 0.975）。以下三项决定系统能否
# 识别并避开慢线路。
#
# 选路时按「账号所绑线路的实测上行带宽」分档收窄候选（≥600KB/s 为快档、
# ≥150 为中档）。数据来自真实请求的 up_kbps（EWMA），不采信探针 kbps——
# 探针写的是 TLS 端口，边缘 10ms 内 400 并重置，字节/耗时会变成「缓冲容量」，
# 实测同一条线高估 5.2~10.8 倍、也低估 5.4 倍，方向都不确定。
# 关闭后选路行为与 2.12 完全一致。
# ZCODE_SELECT_UPLINK_BAND=true
#
# 首字节预算：覆盖「建连 + 上传 + 收到响应头」。默认 90s 对 324KB 请求体等价于
# 「速率 <3.7KB/s 才中止」，等于没有判据；实测快线传 8MiB 仅需 3.5~13.5s，
# 25s 有充足余量。慢线（<20KB/s 传 324KB 需 16s+）会被提前中断并换线。
# ZCODE_UPSTREAM_FIRST_BYTE_TIMEOUT=25
#
# 深度探测（隧道实测上行）。4MiB 载荷 + 跳过前 128KB：所有线路前 ~128KB 会瞬间
# 写进内核缓冲（0.2~0.3s），之后才跌到真实链路速率，不跳过则全程平均被抬高。
# ZCODE_PROXY_DEEP_PROBE=shadow    # off | shadow（只记录）| enforce（并入判定）
# ZCODE_PROXY_DEEP_BYTES=4194304
# ZCODE_PROXY_DEEP_SKIP_BYTES=131072
# ZCODE_PROXY_DEEP_BUDGET_MS=30000
# ZCODE_PROXY_DEEP_MIN_BYTES=524288
# ZCODE_PROXY_DEEP_MIN_KBPS=85

# ── 无痕验证求解（无浏览器：Node + jsdom）──────────
# Node 可执行文件（默认走 PATH 中的 node）
# ZCODE_NODE_PATH=node
# 单次求解超时（秒）与失败重试次数
# ZCODE_CAPTCHA_TIMEOUT=40
# ZCODE_CAPTCHA_RETRIES=4

# ── 验证码缓存 ────────────────────────────────────
# CAPTCHA_CACHE_TTL=45000
# CAPTCHA_CONFIG_CACHE_TTL=600000
# ZCode 3.14.4 起按上游 skip_model_request 自动跳过模型验证码；套餐领取仍需验证。
# 不要为了跳过模型验证码关闭 ZCODE_CAPTCHA_BROWSER，否则会影响自动领取。

# ── 浏览器资源回收（全部可设 0 关闭）──────────────
# worker 寿命上限：存活秒数 / 求解次数 / 父进程 RSS(MB)，任一命中即在两次
# 求解之间重建。浏览器复用同一页面，状态只增不减——真机实测同一只 renderer
# 跑 3 天后 RSS 从 174MB 涨到 1509MB、CPU 从 3.4% 涨到 30.7%。
# ZCODE_CAPTCHA_BROWSER_MAX_AGE_SECONDS=21600
# ZCODE_CAPTCHA_BROWSER_MAX_SOLVES=5000
# ZCODE_CAPTCHA_BROWSER_MAX_RSS_MB=1500
# 池级空闲停池：连续 N 秒没有求解就释放整个浏览器，下次冷启动约 8 秒。
# 每次重启都是一次设备指纹轮换，阈值不宜过小。
# ZCODE_CAPTCHA_BROWSER_IDLE_STOP_SECONDS=1800
# ZCODE_CAPTCHA_BROWSER_MIN_STOP_INTERVAL_SECONDS=1800

# ── 上游端点（一般无需修改）───────────────────────
# ZAI_UPSTREAM_URL=https://zcode.z.ai/api/v1/zcode-plan/anthropic/v1/messages
# ZAI_FALLBACK_URL=https://api.z.ai/api/anthropic/v1/messages
# BIGMODEL_UPSTREAM_URL=https://open.bigmodel.cn/api/anthropic/v1/messages
# ZCODE_CLIENT_VERSION=3.18.0
# 回退到旧档案时同时改版本与 UA：ZCODE_CLIENT_VERSION=3.17.2 / UPSTREAM_USER_AGENT=ZCode/3.17.2
# UPSTREAM_USER_AGENT=ZCode/3.18.0
# 模型 UA 的兼容声明，不是网关运行时依赖；显式覆盖值不会随升级自动变化。
# ZCODE_CLIENT_AISDK_VERSION=4.0.27
# ZCODE_CLIENT_NODE_MAJOR=24
# 客户端配置查询会将复合平台转换为查询格式，如 win32-x64 -> windows-x86_64。
# ZCODE_CLIENT_PLATFORM=win32-x64
# 默认只原样保留「首段为官方固定前缀（或显式空值 / 消息内 system）」的调用者 system；
# 非官方前缀或完全缺失时前置官方标准块（精确去重），保证上游从第 0 字节的校验通过。
# false 可恢复旧版「一律前置标准块」的全量回退行为，修改后需重启。
# ZCODE_PRESERVE_CLIENT_CONTEXT=true
# 遥测设备字段：应与 ZCODE_CLIENT_PLATFORM 相符（默认伪装 Windows 桌面客户端）。
# 不要改成容器真实的 linux / UTC / en-US——事件体与请求头自相矛盾时，上游可能
# 据此判定「非官方客户端」而不投放活动套餐（领取不到 start plan 的常见原因）。
# ZCODE_CLIENT_OS_VERSION=10.0.26100
# ZCODE_CLIENT_LANGUAGE=zh-CN
# ZCODE_CLIENT_TIMEZONE=Asia/Shanghai

# ── 可选的额外风控静默隔离 ─────────────────────
# 默认0：仅按5/15/60分钟阶梯冷却，到期重新参与选号，超档失效。
# 显式大于0才额外隔离，并让窗口内的人工恢复转入保护冷却；不代表上游封禁期限。
# 从v2.9.19/v2.10.0升级时，若曾显式设为24，需改为0或移除覆盖才能恢复默认阶梯。
# ZCODE_RISK_SILENT_HOURS=0
